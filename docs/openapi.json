{
  "openapi": "3.1.0",
  "info": {
    "title": "safe-grokbot-bridge",
    "description": "A narrow, authenticated API that lets a remote AI agent work with this machine: read the folders it was given access to and their git history, see the coding-agent sessions (Claude Code, Codex, Hermes) running there, talk to them, and start new ones.\n\nUsage notes:\n- Every request except `GET /healthz` needs `Authorization: Bearer <token>`.\n- Start with `GET /v1/info`: it lists the folders (workspaces) you may access and what you may do in each (`files`, `git`, `sessions`, `input`, `start`), plus the available agents.\n- All paths are absolute. A session's `cwd` can be passed straight to the file and git endpoints.\n- Agents work for minutes. After sending input, call `GET /v1/sessions/{id}?wait=60` to wait until the session stops working instead of polling in a tight loop.\n- Errors have the shape `{\"error\": {\"code\": ..., \"message\": ...}}`; the message says what to do.",
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "info"
        ],
        "summary": "Liveness probe. Needs no token and reveals nothing.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The bridge is running",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "ok"
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/v1/files": {
      "get": {
        "tags": [
          "files"
        ],
        "summary": "Lists a directory. Entries ignored by `.gitignore` or matching the workspace's deny patterns\n(secrets such as `.env` files and keys) are left out.",
        "operationId": "list_files",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "description": "Absolute path of a directory inside a workspace with the `files` capability.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Levels to descend, 1–5 (default 1: direct children only).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of entries, 1–2000 (default 200).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileList"
                }
              }
            }
          },
          "400": {
            "description": "Not an absolute directory path",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Outside the workspaces, denied, or `files` not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "The directory does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/files/content": {
      "get": {
        "tags": [
          "files"
        ],
        "summary": "Reads a range of lines from a text file. When `truncated` is true, continue with\n`start_line = next_start_line`.",
        "operationId": "read_file",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "description": "Absolute path of a text file inside a workspace with the `files` capability.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_line",
            "in": "query",
            "description": "First line to return, 1-based (default 1).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "max_lines",
            "in": "query",
            "description": "Number of lines to return, 1–4000 (default 400).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileContent"
                }
              }
            }
          },
          "400": {
            "description": "Not a file, or `start_line` past the end",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Outside the workspaces, denied, or `files` not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "The file does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "File larger than 10 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "415": {
            "description": "Binary file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/git/diff": {
      "get": {
        "tags": [
          "git"
        ],
        "summary": "A diff with a summary (`--stat`) followed by the patch.",
        "operationId": "git_diff",
        "parameters": [
          {
            "name": "dir",
            "in": "query",
            "description": "Absolute path of a directory inside a git repository and a workspace with the `git`\ncapability.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rev",
            "in": "query",
            "description": "Compare with this revision or range, e.g. `HEAD~3` or `main..feature`. Without it, the\nworking tree is compared with the index.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "staged",
            "in": "query",
            "description": "Show staged changes (`git diff --cached`).",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "path",
            "in": "query",
            "description": "Limit the diff to this path, relative to `dir`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitOutput"
                }
              }
            }
          },
          "400": {
            "description": "Not a git repository or invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Outside the workspaces or `git` not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/git/log": {
      "get": {
        "tags": [
          "git"
        ],
        "summary": "Commit history, one commit per line: `<hash>\\t<ISO date>\\t<author>\\t<subject>`.",
        "operationId": "git_log",
        "parameters": [
          {
            "name": "dir",
            "in": "query",
            "description": "Absolute path of a directory inside a git repository and a workspace with the `git`\ncapability.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of commits, 1–500 (default 30).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "rev",
            "in": "query",
            "description": "Revision or range, e.g. `main`, `origin/main..HEAD` (default: `HEAD`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "description": "Only commits touching this path, relative to `dir`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitOutput"
                }
              }
            }
          },
          "400": {
            "description": "Not a git repository or invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Outside the workspaces or `git` not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/git/show": {
      "get": {
        "tags": [
          "git"
        ],
        "summary": "One commit: metadata, summary and patch.",
        "operationId": "git_show",
        "parameters": [
          {
            "name": "dir",
            "in": "query",
            "description": "Absolute path of a directory inside a git repository and a workspace with the `git`\ncapability.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rev",
            "in": "query",
            "description": "Commit to show (default `HEAD`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "description": "Limit the patch to this path, relative to `dir`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitOutput"
                }
              }
            }
          },
          "400": {
            "description": "Not a git repository or invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Outside the workspaces or `git` not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/git/status": {
      "get": {
        "tags": [
          "git"
        ],
        "summary": "`git status --short --branch`: the current branch and changed files.",
        "operationId": "git_status",
        "parameters": [
          {
            "name": "dir",
            "in": "query",
            "description": "Absolute path of a directory inside a git repository and a workspace with the `git`\ncapability.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitOutput"
                }
              }
            }
          },
          "400": {
            "description": "Not a git repository or invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Outside the workspaces or `git` not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/info": {
      "get": {
        "tags": [
          "info"
        ],
        "summary": "Describes this machine: version, agents, the workspaces you may access and the limits.\nCall this first.",
        "operationId": "info",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentInfo": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "available",
          "headless"
        ],
        "properties": {
          "available": {
            "type": "boolean",
            "description": "Whether the agent's command was found on this machine."
          },
          "headless": {
            "type": "boolean",
            "description": "Whether the agent can run headless (one non-interactive turn per message)."
          },
          "kind": {
            "$ref": "#/components/schemas/AgentKind"
          },
          "name": {
            "type": "string",
            "description": "Name to use in `agent` when starting a session."
          }
        }
      },
      "AgentKind": {
        "type": "string",
        "description": "Which agent CLI an agent entry drives. `generic` is any other terminal program; it can only\nrun in tmux.",
        "enum": [
          "claude",
          "codex",
          "hermes",
          "generic"
        ]
      },
      "Capability": {
        "type": "string",
        "description": "Folder-level permission granted to clients.",
        "enum": [
          "files",
          "git",
          "sessions",
          "input",
          "start"
        ]
      },
      "EntryKind": {
        "type": "string",
        "enum": [
          "file",
          "dir",
          "symlink",
          "other"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "description": "Error response body.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error code, e.g. `forbidden`, `not_found`, `busy`."
          },
          "message": {
            "type": "string",
            "description": "What went wrong and what to do about it."
          }
        }
      },
      "FileContent": {
        "type": "object",
        "description": "A range of lines from a text file.",
        "required": [
          "path",
          "size",
          "total_lines",
          "start_line",
          "end_line",
          "truncated",
          "content"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "end_line": {
            "type": "integer",
            "description": "Last line returned (1-based, inclusive); 0 for an empty file.",
            "minimum": 0
          },
          "next_start_line": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Where to continue reading when `truncated` is `true`.",
            "minimum": 0
          },
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "File size in bytes.",
            "minimum": 0
          },
          "start_line": {
            "type": "integer",
            "description": "First line returned (1-based).",
            "minimum": 0
          },
          "total_lines": {
            "type": "integer",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean",
            "description": "`true` when the file continues after `end_line`."
          }
        }
      },
      "FileEntry": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/EntryKind"
          },
          "modified": {
            "type": [
              "string",
              "null"
            ],
            "description": "Last modification time, RFC 3339."
          },
          "path": {
            "type": "string",
            "description": "Absolute path; pass it to `/v1/files/content` or, for directories, to `/v1/files`."
          },
          "size": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Size in bytes (files only).",
            "minimum": 0
          }
        }
      },
      "FileList": {
        "type": "object",
        "description": "A directory listing.",
        "required": [
          "path",
          "entries",
          "truncated"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileEntry"
            },
            "description": "Entries in path order. Files ignored by `.gitignore` and paths matching the workspace's\ndeny patterns are left out."
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explains an empty or truncated listing."
          },
          "path": {
            "type": "string",
            "description": "The listed directory (canonical absolute path)."
          },
          "truncated": {
            "type": "boolean",
            "description": "`true` when `limit` cut the listing short."
          }
        }
      },
      "GitOutput": {
        "type": "object",
        "description": "Output of a git command.",
        "required": [
          "dir",
          "command",
          "output",
          "truncated"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The git command that ran, for reference."
          },
          "dir": {
            "type": "string",
            "description": "Directory the command ran in."
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explains empty or truncated output."
          },
          "output": {
            "type": "string",
            "description": "Raw git output. `log` lines are `<hash>\\t<ISO date>\\t<author>\\t<subject>`."
          },
          "truncated": {
            "type": "boolean",
            "description": "`true` when the output was cut at 256 KiB; narrow it with `path`, `rev` or `limit`."
          }
        }
      },
      "Info": {
        "type": "object",
        "description": "Overview of this machine and what this token may do here.",
        "required": [
          "name",
          "version",
          "os",
          "arch",
          "time",
          "agents",
          "workspaces",
          "limits"
        ],
        "properties": {
          "agents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentInfo"
            },
            "description": "Configured agents. Only agents listed in a workspace's `agents` may be started there."
          },
          "arch": {
            "type": "string"
          },
          "limits": {
            "$ref": "#/components/schemas/LimitsInfo"
          },
          "name": {
            "type": "string",
            "description": "Display name of this machine."
          },
          "os": {
            "type": "string",
            "description": "Operating system (`linux`, `macos`, `windows`)."
          },
          "time": {
            "type": "string",
            "description": "Current server time, RFC 3339."
          },
          "version": {
            "type": "string",
            "description": "Bridge version."
          },
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkspaceInfo"
            },
            "description": "Folders this bridge exposes. A workspace covers its `path` and everything below it."
          }
        }
      },
      "LimitsInfo": {
        "type": "object",
        "required": [
          "requests_per_minute",
          "max_sessions",
          "max_wait_secs"
        ],
        "properties": {
          "max_sessions": {
            "type": "integer",
            "description": "Sessions started by the bridge that may run at the same time.",
            "minimum": 0
          },
          "max_wait_secs": {
            "type": "integer",
            "format": "int64",
            "description": "Maximum `wait` for long-polling a session, in seconds.",
            "minimum": 0
          },
          "requests_per_minute": {
            "type": "integer",
            "format": "int32",
            "description": "Requests allowed per minute for this token.",
            "minimum": 0
          }
        }
      },
      "WorkspaceInfo": {
        "type": "object",
        "required": [
          "name",
          "path",
          "allow",
          "agents",
          "allow_bypass_permissions"
        ],
        "properties": {
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Agents that may be started here."
          },
          "allow": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "description": "What clients may do in this folder."
          },
          "allow_bypass_permissions": {
            "type": "boolean",
            "description": "Whether sessions may be started with `bypass_permissions: true`."
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Absolute folder path."
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "sgb_<64 hex characters>",
        "description": "Token created with `safe-grokbot-bridge token`."
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "info",
      "description": "Machine overview"
    },
    {
      "name": "files",
      "description": "Read-only file access"
    },
    {
      "name": "git",
      "description": "Read-only git access"
    }
  ]
}
